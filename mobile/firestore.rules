rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Conversation ids are `{uidA}_{uidB}` with Firebase UIDs (no underscores).
    function uidInConversationId(conversationId) {
      return conversationId.matches('^' + request.auth.uid + '_.+')
        || conversationId.matches('^.+_' + request.auth.uid + '$');
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.memberIds;
    }

    match /chatUsers/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.email is string
        && request.resource.data.name is string;
      allow delete: if false;
    }

    match /chatEmails/{email} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/chatEmails/$(email))
            || get(/databases/$(database)/documents/chatEmails/$(email)).data.uid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /chatConversations/{conversationId} {
      // getDoc on a missing conversation used to fail with
      // "Missing or insufficient permissions" because `resource` is null and
      // `resource.data.memberIds` cannot be evaluated. Allow that probe only
      // when the conversation id includes the caller's uid (new DM create path).
      allow get: if signedIn() && (
        (resource == null && uidInConversationId(conversationId))
        || (resource != null && request.auth.uid in resource.data.memberIds)
      );
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 2
        && uidInConversationId(conversationId);
      allow update: if isConversationMember(conversationId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
