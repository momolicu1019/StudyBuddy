# Copy to .env and restart Expo (`npx expo start -c`).

# --- Google OAuth (login) ---
# Web client ID is required to enable real Google sign-in.
# Android client ID needs package com.studybuddy.ai + your SHA-1.
# iOS client ID optional until you ship iOS with Google Sign-In.
# Without these, the app uses a demo Google session on-device.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Gemini (AI Tutor + flashcard generation) ---
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EXPO_PUBLIC_AI_MODEL=gemini-flash-latest
