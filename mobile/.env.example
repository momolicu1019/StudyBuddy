# Copy to .env and restart Expo (`npx expo start -c`).

# --- Google Sign-In (login) ---
# Real Google Sign-In uses the native SDK (@react-native-google-signin/google-signin).
# It does NOT work in Expo Go — use an EAS development or preview build.
#
# 1) Google Cloud Console → APIs & Services → Credentials
# 2) Create OAuth client "Web application" → paste ID below (required)
#    IMPORTANT: webClientId must be type Web, NOT Android (or you get DEVELOPER_ERROR).
# 3) Create OAuth client "Android"
#      package name: com.studybuddy.ai
#      SHA-1: from `npm run apk:sha1 -- path/to.apk` or `eas credentials`
#      Current EAS preview APK (v1.0.1) SHA-1:
#      1B:7E:FF:3F:71:E8:DF:49:92:77:0E:AF:FE:D7:E0:94:4D:08:B4:8E
# 4) Optional iOS OAuth client → bundle ID com.studybuddy.ai → set IOS id below
# 5) Rebuild the app after changing native deps / env values baked into the binary
#
# Without a Web client ID (or without a native build), the app uses a demo Google session.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Gemini (AI Tutor + flashcard generation) ---
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Student chat (Firebase Auth + Firestore) ---
# See mobile/FIREBASE_CHAT.md for console setup steps.
# Copy values from Firebase Console → Project settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Android app id from Firebase Console → Project settings → Your apps → Android
# (looks like 1:123456789:android:abcdef). Required for closed-app chat push —
# app.config.js writes google-services.json from this at EAS build time.
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=
# Optional salt used to map StudyBuddy accounts to Firebase email/password auth
EXPO_PUBLIC_FIREBASE_CHAT_PEPPER=
