rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Conversation ids are `{uidA}_{uidB}` with Firebase UIDs (no underscores).
    function uidInConversationId(conversationId) {
      return conversationId.matches('^' + request.auth.uid + '_.+')
        || conversationId.matches('^.+_' + request.auth.uid + '$');
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.memberIds;
    }

    function validMemberMaps() {
      return request.resource.data.members is map
        && request.resource.data.unread is map
        && request.resource.data.memberIds is list;
    }

    function isDmCreate(conversationId) {
      return request.resource.data.memberIds.size() == 2
        && uidInConversationId(conversationId)
        && (!('type' in request.resource.data) || request.resource.data.type == 'dm');
    }

    function isGroupCreate() {
      return request.resource.data.type == 'group'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 20;
    }

    match /chatUsers/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.email is string
        && request.resource.data.name is string
        && (!('expoPushTokens' in request.resource.data)
            || request.resource.data.expoPushTokens is list);
      allow delete: if false;
    }

    match /chatEmails/{email} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/chatEmails/$(email))
            || get(/databases/$(database)/documents/chatEmails/$(email)).data.uid == request.auth.uid);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    function isGroupTitleUpdate() {
      return resource.data.type == 'group'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title']);
    }

    match /chatConversations/{conversationId} {
      // getDoc on a missing conversation used to fail with
      // "Missing or insufficient permissions" because `resource` is null and
      // `resource.data.memberIds` cannot be evaluated. Allow that probe only
      // when the conversation id includes the caller's uid (new DM create path).
      allow get: if signedIn() && (
        (resource == null && uidInConversationId(conversationId))
        || (resource != null && request.auth.uid in resource.data.memberIds)
      );
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && validMemberMaps()
        && (isDmCreate(conversationId) || isGroupCreate());
      // Members may update unread/lastMessage, or rename a group title.
      allow update: if isConversationMember(conversationId)
        && (
          isGroupTitleUpdate()
          || request.resource.data.memberIds == resource.data.memberIds
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId is string
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && (
            // Normal sends: only as yourself.
            request.resource.data.senderId == request.auth.uid
            // Drive sync restore: members may re-add historical messages
            // authored by anyone already in the conversation.
            || (
              request.resource.data.restored == true
              && request.resource.data.senderId in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.memberIds
            )
          );
        allow update, delete: if false;
      }
    }
  }
}
