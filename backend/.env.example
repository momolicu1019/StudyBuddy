# Copy to backend/.env (never commit .env).
# Neon: use the pooled connection string for the API when available.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

DATABASE_URL=

# Used to sign chat JWTs — change in production.
CHAT_JWT_SECRET=change-me-studybuddy-chat-secret

# Optional JWT lifetime in hours (default 720 = 30 days)
CHAT_JWT_HOURS=720
