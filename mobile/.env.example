# Copy to .env and restart Expo (`npx expo start -c`).

# --- Optional: Google Drive backup ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- AI Tutor (free options supported) ---
# Uses any OpenAI-compatible Chat Completions API.
#
# Option A — Groq (free tier, recommended to start)
# 1) Create a key: https://console.groq.com/keys
# 2) Paste values below:
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_AI_BASE_URL=https://api.groq.com/openai/v1
EXPO_PUBLIC_AI_MODEL=llama-3.1-8b-instant
#
# Option B — Google Gemini (free tier)
# 1) Create a key: https://aistudio.google.com/apikey
# 2) Use:
# EXPO_PUBLIC_AI_API_KEY=your_gemini_key
# EXPO_PUBLIC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EXPO_PUBLIC_AI_MODEL=gemini-2.0-flash
#
# Option C — OpenAI (paid)
# EXPO_PUBLIC_AI_BASE_URL=https://api.openai.com/v1
# EXPO_PUBLIC_AI_MODEL=gpt-4o-mini
